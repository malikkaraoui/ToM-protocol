# Copy this file to .env and fill values.

# GitBook MCP authentication
# Provide a GitBook API token with access to the target organization/space.
GITBOOK_TOKEN=

# Infra perso du fondateur (scripts/car-test.sh, deploy-nas-node.sh, nas-node-ctl.sh).
# Aucune valeur ici : le dépôt est public. Les scripts s'arrêtent si elles manquent.
# Hôte public (IP ou nom) du NAS du domicile.
TOM_HOME_HOST=
# Mot de passe SSH du NAS pour car-test.sh en mode tunnel (préférer une clé SSH).
TOM_NAS_SSH_PASS=
