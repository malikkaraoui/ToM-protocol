{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "*.tsbuildinfo",
      ".claude",
      ".claude-backup-*",
      ".obsidian",
      "graphify-out",
      "_bmad-output",
      "_bmad",
      "target",
      "build",
      ".build",
      "experiments/**/target",
      "apps/**/Assets.xcassets/**",
      "apps/**/.build/**",
      "apps/**/build-*/**",
      "sdk/swift/**/.build/**",
      "sdk/swift/**/Artifacts/**",
      "docs/spec/vectors/**",
      "patches/**",
      "graphify-out"
    ]
  }
}
